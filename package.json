{
  "name": "@kishanscaler/ssx-ui",
  "version": "0.6.0",
  "description": "Scaler Design System — React components. One system, two sub-brands (SST, SSB), two modes.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/legacy/vendor/**"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/legacy/index.cjs",
  "module": "./dist/legacy/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles/ssx.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./standalone.css": "./dist/ssx.standalone.css",
    "./dist/ssx.standalone.css": "./dist/ssx.standalone.css",
    "./dist/styles/*.css": "./dist/styles/*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "sync:logos": "node scripts/build-logos.mjs",
    "prebuild": "npm run sync:tokens && npm run sync:logos",
    "build": "npm run build:js && npm run build:types && npm run build:styles && npm run build:css && npm run check:directives && npm run check:legacy",
    "build:js": "vite build -c vite.lib.config.ts && SSX_BUILD_VARIANT=legacy vite build -c vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.build.json && node scripts/fix-dts-extensions.mjs",
    "build:styles": "node scripts/copy-styles.mjs",
    "build:css": "tailwindcss -i ./src/styles/standalone.css -o ./dist/ssx.standalone.css --minify",
    "check:directives": "node scripts/check-directives.mjs",
    "check:publint": "publint --strict",
    "check:types": "attw --pack . --exclude-entrypoints ./styles.css ./fonts.css ./standalone.css ./dist/ssx.standalone.css ./dist/styles/*.css",
    "check:package": "npm run check:publint && npm run check:types",
    "smoke": "node scripts/smoke.mjs",
    "prestorybook": "npm run sync:tokens && npm run sync:logos",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run sync:tokens && npm run sync:logos",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run sync:tokens && npm run sync:logos",
    "test": "npm run test:react19 && npm run test:react16",
    "test:watch": "vitest",
    "clean": "rm -rf dist storybook-static",
    "smoke:legacy": "node scripts/smoke-legacy.mjs",
    "test:react19": "vitest run",
    "test:react16": "vitest run -c vitest.react16.config.ts",
    "check:legacy": "node scripts/check-legacy.mjs",
    "check:reflow": "node scripts/reflow-sweep.mjs"
  },
  "peerDependencies": {
    "react": "^16.12.0 || ^17 || ^18 || ^19",
    "react-dom": "^16.12.0 || ^17 || ^18 || ^19"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "^9.0.0",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "^8.18.0",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-values-parser": "^2.0.1",
    "publint": "^0.3.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "ssx-react16-env": "file:test-env/react16",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-system",
    "react",
    "scaler",
    "sst",
    "ssb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kishanscaler/ssx-ui.git"
  },
  "homepage": "https://ssx-ui-storybook.vercel.app",
  "bugs": {
    "url": "https://github.com/Kishanscaler/ssx-ui/issues"
  }
}
